{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ziztu",
  "version": "1.2.0",
  "description": "Ziztu AI video studio for your agent. Ziztu YouTube Studio directs a narrated faceless YouTube video from a faceless channel script, Ziztu Reel Studio directs short reels and YouTube Shorts scene by scene, and the Ziztu MCP server makes micro dramas and anime episodes. Four skills write faceless YouTube scripts, viral reels, micro drama series and cinematic image and video prompts.",
  "author": {
    "name": "Ziztu",
    "email": "support@getziztu.com",
    "url": "https://getziztu.com"
  },
  "homepage": "https://getziztu.com/docs/mcp",
  "repository": "https://github.com/0xnirlin/ziztu",
  "license": "MIT",
  "keywords": [
    "ai-video",
    "video-generation",
    "reels",
    "faceless-channel-script",
    "youtube-video",
    "micro-drama",
    "anime",
    "viral-reels",
    "youtube-shorts",
    "tiktok",
    "faceless-youtube",
    "mcp",
    "ziztu"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "ziztu": {
          "trust": "untrusted",
          "timeout": 180
        },
        "ziztu-youtube": {
          "trust": "untrusted",
          "timeout": 180
        },
        "ziztu-reel": {
          "trust": "untrusted",
          "timeout": 180
        }
      }
    }
  }
}
